# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
SENTINEL_KEYPAIR=your-base58-encoded-keypair-here
SENTINEL_PROGRAM_ID=your-program-id-here

# Helius API
HELIUS_API_KEY=your-helius-api-key-here
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your-helius-api-key-here

# Nosana Network
NOSANA_API_KEY=your-nosana-api-key-here
NOSANA_NETWORK=testnet

# Switchboard Oracle
SWITCHBOARD_API_KEY=your-switchboard-api-key-here
SWITCHBOARD_PROGRAM_ID=your-switchboard-program-id-here

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# x402 Configuration
X402_PAYMENT_RECIPIENT=your-payment-recipient-pubkey-here
X402_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Pricing Configuration (in USDC)
TIER_BASIC_PRICE=0
TIER_STANDARD_PRICE=0.1
TIER_PREMIUM_PRICE=0.5
SUBSCRIPTION_ALERT_FEE=0.05
HISTORICAL_REPORT_FEE=0.02

# Rate Limiting
RATE_LIMIT_FREE_TIER=10
RATE_LIMIT_PAID_TIER=100
RATE_LIMIT_WINDOW=3600

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:9002
NODE_ENV=development

# Google AI (existing)
GOOGLE_GENAI_API_KEY=your-google-ai-api-key-here
